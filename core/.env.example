JAMESCORE_HTTP_HOST=127.0.0.1
JAMESCORE_HTTP_PORT=8010
JAMESCORE_DATA_DIR=./data
JAMESCORE_ASSERTION_SECRET=change-me-jamescore-sandbox
JAMESCORE_ASSERTION_ISS=james-portal
JAMESCORE_ASSERTION_AUD=jamescore

# PKE v1 — congelado. Código: Jamesbrain/pke. Instância James: :8008
# Público: https://pke.james.sandbox.momsys.com.br
PKE_API_URL=http://127.0.0.1:8008
PKE_TIMEOUT_SECONDS=60
PKE_AUTH_PREFIX=dev:james-

# Presenter (speech). Same DeepSeek key as PKE Interpreter; different prompt/role.
# If secrets are empty here, jamesCore copies missing DEEPSEEK_* / PRESENTER_* from Jamesbrain/pke/.env.
PRESENTER_ENABLED=1
PRESENTER_TIMEOUT_SECONDS=8
# PRESENTER_API_KEY=
# PRESENTER_MODEL=deepseek-flash
# PRESENTER_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash
# Same folder as PKE `{YmdHis}_{client_request_id}.log` so presenter stages join the trace.
# PKE_REQUEST_LOG_DIR=D:/00-LocalServer/htdocs/momsys/james/data/pke/request-logs
# JAMESCORE_REQUEST_LOG=1
