# Copie para .env local. Nunca commitar a chave.
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# PKE_PROVIDER_TIMEOUT_SECONDS=30
# PKE_PROVIDER_MAX_RETRIES=0
# PKE_INTERPRETER_MAX_ATTEMPTS=2
# PKE_INTERPRETER_RETRY_DELAY_SECONDS=0.05

# Product / API v1
# PKE_KNOWLEDGE_DB=data/pke.db
# PKE_PRODUCT_DB=data/pke_product.db
#
# Auth (canonical default = session). DEV_AUTH is opt-in only.
# PKE_AUTH_MODE=session
# PKE_SESSION_TTL_SECONDS=604800
# Stale in_progress lease (seconds) before lazy reconciliation:
# PKE_IDEMPOTENCY_STALE_SECONDS=120
# Explicit test/dev only (never silent production fallback).
# James sandbox precisa disto para Bearer dev:james-{id}:
PKE_AUTH_MODE=dev
# PKE_DEV_USER_ID=dev-user
# PKE_DEV_DISPLAY_NAME=James
#
# CORS: explicit origins only (no wildcard). Bearer auth — credentials=false.
# PKE_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
# PKE_DEBUG_UI=false
# PKE_USER_TIMEZONE=America/Fortaleza
# PKE_HTTP_HOST=127.0.0.1
# PKE_HTTP_PORT=8000
